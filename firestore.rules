rules_version = '2';

// См. ARCHITECTURE.md, раздел 5. Ключевая мысль: клиент не пишет ничего,
// что связано с деньгами. Всё, что меняет wallet/sessions/участников
// комнаты, идёт только через Cloud Functions (admin SDK обходит эти правила).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // только Cloud Functions (admin SDK)

      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /rooms/{roomId} {
      // Список комнат / их метаданные читают все залогиненные пользователи
      // (для лобби), пишут только Cloud Functions.
      allow read: if request.auth != null;
      allow write: if false;

      match /participants/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /state/{doc} {
        // Roster-снапшот раз в секунду — публичный для залогиненных зрителей.
        // При необходимости ограничить только участниками комнаты, замените
        // условие на exists(.../participants/$(request.auth.uid)).
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /checkpoint/{doc} {
        // Только для восстановления процессом на Cloud Run (admin SDK).
        allow read, write: if false;
      }
    }
  }
}
